# docker compose 用的配置。复制为仓库根目录的 .env 后填值（.env 已被 gitignore）。
#
# 【生产：沿用宿主机已有的 MySQL】—— 推荐，不会丢数据
#     docker compose up -d --build
#
# 【本地/全新环境：用 compose 内置的 MySQL】
#     # 注意：不要设 DB_URL，另需 MYSQL_ROOT_PASSWORD
#     docker compose --profile local-db up -d --build
#
# 首次启动会自动跑 alembic 迁移、灌种子数据、构建向量库，无需手工介入。

# ---- 必填 ----

# 生产环境务必换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# 阿里云百炼 DashScope（OpenAI 兼容端点）的 API Key
AI_API_KEY=your-ai-api-key

# ---- 连外部 MySQL 时必填（用内置 MySQL 时请留空/注释掉）----
# DB_URL=mysql+pymysql://root:<密码>@host.docker.internal:3306/couple_translator?charset=utf8mb4

# 用内置 MySQL（--profile local-db）时必填
# MYSQL_ROOT_PASSWORD=change-me

# ---- 可选 ----

# 对外端口，默认 8000
# BACKEND_PORT=8000

# 主模型。qwen3.7-flash 是推理模型：先产出思考再落笔正文，首字延迟明显更高。
AI_MODEL=qwen3.7-flash

# 推理模型的思考预算（token）。思考长度直接等于用户等待：
# 同一封信实测 不限时 → 首字正文 32.9s；压到 1024 → 13.4s。
AI_THINKING_BUDGET=1024
AI_ENABLE_THINKING=true

# AI 端点按用户限流（slowapi 语法，留空关闭），默认 20/hour
# AI_RATE_LIMIT=20/hour

# AI 端点的 IP 维度兜底限流（防批量注册绕开按用户配额），默认 120/hour
# AI_IP_RATE_LIMIT=120/hour

# ---- 军师 AI 记忆系统 v3.2（feature flags，契约附录 §6.2）----
# 四个全为 0（默认）时行为与 v1 完全一致。灰度顺序见 spec/设计/附录 §6.2：
# Schema only → dual write → shadow verify → read canary → v3 default。
# MEMORY_ASSERTION_DUAL_WRITE=1    # 同行双写 legacy+v3 断言列；chat 蒸馏走 pipeline
# MEMORY_ASSERTION_READ_V3=0       # v3 读取路径（阶段 A 只管道，勿开）
# MEMORY_ASSERTION_REQUIRE_COMPLETE=0  # T4 v3 字段不完整时禁止降级 legacy_pending
# MEMORY_ASSERTION_INDEX_WORKER=1  # 进程内索引 Worker（generation CAS）

# ---- 接口文档与跨域 ----

# /docs /redoc /openapi.json 的保护口令（HTTP Basic）。
# openapi.json 会给出全部接口的参数与结构，等同攻击说明书，因此不对外敞开。
# ⚠️ 两者任一为空则一律返回 401（默认拒绝）—— 想用文档就必须设。
# 生成口令：python -c "import secrets;print(secrets.token_urlsafe(18))"
# DOCS_USER=admin
# DOCS_PASS=

# 允许跨站访问的来源，逗号分隔。默认空 = 不允许任何跨站来源。
# Android 客户端走 Retrofit，不受 CORS 约束，留空即可。
# CORS_ORIGINS=

# ---- 邮件（忘记密码验证码 + 「App 被杀也能收到提醒」的通知通道）----
# 本地不想配 SMTP：把 EMAIL_DEV_MODE 设为 true（验证码写库打日志、
# forgot-password 接口直接返回 dev_code）。
# ⚠️ 生产必须 false —— dev 模式会把验证码吐在接口响应里。
EMAIL_DEV_MODE=false

# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的QQ邮箱@qq.com
# SMTP_AUTH_CODE=   # 授权码，不是邮箱密码
# EMAIL_FROM=
