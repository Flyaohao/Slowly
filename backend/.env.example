# 复制为 backend/.env 后填入真实值。.env 已被 gitignore，不要提交。
#
# 本地直接跑（不用容器）时用下面这组；
# 用 docker compose 起的话，配置写在仓库根目录的 .env 里，由 compose 注入。

DB_URL=mysql+pymysql://root:password@localhost:3306/couple_translator?charset=utf8mb4
DB_CHARSET=utf8mb4

# 生产环境务必换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# 阿里云百炼 DashScope（OpenAI 兼容端点）
AI_API_KEY=your-ai-api-key
# 主模型。qwen3.7-flash 属推理模型：先产出 reasoning_content（思考）再产出正文。
# 实测单次结构化调用约 30s、流式首字约 14s，因此：
#   - 后端 llm_client._REQUEST_TIMEOUT 放宽到 120s
#   - 客户端 okhttp readTimeout 放宽到 180s
#   - 流式链路带心跳保活（ai_service._stream_with_heartbeat）
# 换成非推理模型（如 qwen-plus）时首字延迟会明显下降，上述数值可另议。
# deepseek-v4-pro / deepseek-v4-flash 的免费额度已耗尽；
# 降级链见 app/services/llm_client.py 的 FALLBACK_MODELS
AI_MODEL=qwen3.7-flash
# 记忆抽取等后台轻量任务专用模型。这类任务本质是「二分类 + 一句话抽取」，
# 用推理模型实测单次约 10s，轻量模型约 0.4s 且判断结果一致。
AI_MEMORY_MODEL=qwen-turbo
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 推理模型的思考预算（token）。思考是首字延迟的主因：同一封信的解读实测
#   不限（0）        → 思考 9258 字，首字正文 32.9s，总耗时 35.9s
#   1024（默认）     → 思考 3343 字，首字正文 13.4s，总耗时 19.3s
#   关掉思考         → 无思考，     首字正文  0.9s，总耗时  6.1s
AI_THINKING_BUDGET=1024
# 置 false 彻底关掉思考，最快但前端「深度思考」面板会没有内容可显示。
AI_ENABLE_THINKING=true

# 向量库目录。留空 = 用默认的 backend/data/chroma；
# 容器里指向挂载卷，避免重建镜像丢向量
CHROMA_DIR=

# ---- 邮件（注册验证码、忘记密码、以及「App 被杀也能收到提醒」的通知通道）----
# 两个用途：
#   1) 忘记密码 / 验证码类邮件 —— 发不出去这条流程就走不通；
#   2) 通知邮件 —— 用户在 App 里主动开启「邮件通知」后，收信/调解邀请/解绑请求
#      会额外发一封**不含任何内容**的提醒邮件（见 app/services/email_service.py 的
#      NOTIFICATION_MAILS）。开关默认关闭，SMTP 没配时设置页那一项会置灰。
#
# 本地开发如果不想配 SMTP：把 EMAIL_DEV_MODE 设为 true。
#   dev 模式下不发信，验证码改写入数据库并打日志，且 forgot-password 接口
#   会把 dev_code 直接返回，方便联调。
#   ⚠️ 生产环境必须保持 false —— dev 模式会在接口响应里吐出验证码。
EMAIL_DEV_MODE=false

# 下面四项留空即视为「未配置 SMTP」
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的QQ邮箱@qq.com
# 授权码不是邮箱密码：QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务后生成
# SMTP_AUTH_CODE=
# 发件人显示地址，默认取 SMTP_USER
# EMAIL_FROM=
