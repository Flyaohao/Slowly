# 复制为 backend/.env 后填入真实值。.env 已被 gitignore，不要提交。
#
# 本地直接跑（不用容器）时用下面这组；
# 用 docker compose 起的话，配置写在仓库根目录的 .env 里，由 compose 注入。

DB_URL=mysql+pymysql://root:password@localhost:3306/couple_translator?charset=utf8mb4
DB_CHARSET=utf8mb4

# 生产环境务必换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# 阿里云百炼 DashScope（OpenAI 兼容端点）
AI_API_KEY=your-ai-api-key
# 主模型。deepseek-v4-pro / deepseek-v4-flash 的免费额度已耗尽，当前用 qwen-plus；
# 降级链见 app/services/llm_client.py 的 FALLBACK_MODELS
AI_MODEL=qwen-plus
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 向量库目录。留空 = 用默认的 backend/data/chroma；
# 容器里指向挂载卷，避免重建镜像丢向量
CHROMA_DIR=
