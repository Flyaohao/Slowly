# 复制为 backend/.env 后填入真实值。.env 已被 gitignore，不要提交。
#
# 本地直接跑（不用容器）时用下面这组；
# 用 docker compose 起的话，配置写在仓库根目录的 .env 里，由 compose 注入。

DB_URL=mysql+pymysql://root:password@localhost:3306/couple_translator?charset=utf8mb4
DB_CHARSET=utf8mb4

# 生产环境务必换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# 阿里云百炼 DashScope（OpenAI 兼容端点）
AI_API_KEY=your-ai-api-key
# 主模型。qwen3.7-flash 属推理模型：先产出 reasoning_content（思考）再产出正文。
# 实测单次结构化调用约 30s、流式首字约 14s，因此：
#   - 后端 llm_client._REQUEST_TIMEOUT 放宽到 120s
#   - 客户端 okhttp readTimeout 放宽到 180s
#   - 流式链路带心跳保活（ai_service._stream_with_heartbeat）
# 换成非推理模型（如 qwen-plus）时首字延迟会明显下降，上述数值可另议。
# deepseek-v4-pro / deepseek-v4-flash 的免费额度已耗尽；
# 降级链见 app/services/llm_client.py 的 FALLBACK_MODELS
AI_MODEL=qwen3.7-flash
# 记忆抽取等后台轻量任务专用模型。这类任务本质是「二分类 + 一句话抽取」，
# 用推理模型实测单次约 10s，轻量模型约 0.4s 且判断结果一致。
AI_MEMORY_MODEL=qwen-turbo
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 向量库目录。留空 = 用默认的 backend/data/chroma；
# 容器里指向挂载卷，避免重建镜像丢向量
CHROMA_DIR=
