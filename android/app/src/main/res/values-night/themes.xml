<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色模式系统主题：避免启动/转场瞬间露出白色窗口 -->
    <style name="Theme.CoupleTranslator" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 深色模式下启动画面仍用品牌浅色启动图（与亮色一致），仅父主题跟随深色 -->
    <style name="Theme.CoupleTranslator.Launch" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
